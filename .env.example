# Environment for `docker compose` (copy to .env and fill in).
# Local development without Docker uses backend/.env instead.

POSTGRES_USER=risk_app
POSTGRES_PASSWORD=change_me
POSTGRES_DB=transaction_risk_db

# Host port for the web console (frontend + proxied API).
FRONTEND_PORT=8080

# Browser origins allowed to call the API directly (comma-separated).
# Not needed when the API is only reached through the frontend's /api proxy.
CORS_ORIGINS=http://localhost:8080

LOG_LEVEL=INFO
UVICORN_WORKERS=2
