# Backend configuration for local development (copy to backend/.env).
# Variable names map to fields in app/core/config.py (case-insensitive).

PROJECT_NAME=AI Transaction Risk Scoring System
PROJECT_VERSION=1.0.0
DEBUG=false
HOST=127.0.0.1
PORT=8000

API_PREFIX=/api/v1
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://postgres:your_password_here@localhost:5432/transaction_risk_db

# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173
